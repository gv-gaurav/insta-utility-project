PORT=5055
LIVE_WRITE_ENABLED=false

# Authorised CORS Origins Allow-List (Comma-separated, exact https origins, no wildcard *)
ALLOWED_ORIGINS=https://gv-gaurav.github.io,http://localhost:8000,http://127.0.0.1:8000

# Zoho CRM OAuth Credentials (Set securely in Server Environment - DO NOT COMMIT SECRETS TO GIT)
ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID_HERE
ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET_HERE
ZOHO_GRANT_TYPE=client_credentials
ZOHO_SCOPE=ZohoCRM.modules.ALL
ZOHO_SOID=ZohoCRM.60046335348

# Zoho Endpoint URLs
ZOHO_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_LEAD_URL=https://www.zohoapis.in/crm/v8/Website_Leads
