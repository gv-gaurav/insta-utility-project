# Deny direct web access to sensitive config, secrets, state files, and logs
<FilesMatch "^\.env|config\.php|\.json$|\.log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent Directory Browsing
Options -Indexes




